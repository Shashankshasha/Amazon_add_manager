# Copy this file to .env and fill in real values. NEVER commit .env.
# None of these exist yet (developer identity verification is still pending) -
# leave them blank until Phase 1/2 of the implementation plan is complete.

# --- Login with Amazon (LwA) security profile: "SAFAR Ads Manager" ---
# Created in Amazon Developer Console after identity verification succeeds.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

# --- OAuth refresh token obtained after the owner completes the LwA consent screen ---
AMAZON_ADS_REFRESH_TOKEN=

# --- India Sponsored Products advertiser profile id (Amazon Ads Profiles API) ---
# Must be locked and allow-listed before any write call is permitted. See
# docs/04-financial-guardrails.md.
AMAZON_ADS_PROFILE_ID=

# --- Amazon Ads API base URL (region-specific; NA/EU/FE all differ from India's) ---
# India traffic is served from the EU endpoint per Amazon Ads API docs.
AMAZON_ADS_API_BASE_URL=https://advertising-api-eu.amazon.com

# --- Login with Amazon token endpoint (fixed, not region-specific) ---
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token

# --- Safety ---
# Master kill switch. Set to "true" to immediately block every write call
# regardless of any other setting. Default is safe (writes blocked) until
# explicitly turned off by the owner.
SAFAR_ADS_KILL_SWITCH=true

# Set to "false" only when the owner has explicitly approved moving off
# dry-run/mock mode. Until Phase 1/2 are complete this MUST stay true.
SAFAR_ADS_DRY_RUN=true
